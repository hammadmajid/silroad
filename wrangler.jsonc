/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "silroad",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-08-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"NODE_ENV": "production"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"env": {
		"dev": {
			"vars": {
				"NODE_ENV": "development"
			}
		}
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "silroad.me",
			"custom_domain": true
		},
		{
			"pattern": "www.silroad.me",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "silroad",
			"database_id": "4b0a57b1-84c0-4904-87ff-d82c41188327",
			"migrations_dir": "drizzle/"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "2f8dae5639ec4393bd1f4031ab2d89a1",
			"preview_id": "f022f4074ec9401c9d5d1e38df373360"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "LOGGER",
			"dataset": "silroad_logs"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "silroad",
			"binding": "BUCKET"
		}
	]
}